<?xml version="1.0" encoding="utf-8"?>
<!-- 直拿時的狀態列：寬度不夠排成一列，名稱和收音在上面、計時在下一行；上傳狀態在按鈕上面 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 收音那格先量，剩下的寬度給名稱和連線狀態，太長就換行 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ECE8E1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/connection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8B919A"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/mic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill"
                android:maxWidth="160dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="#ECE8E1"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill"
            android:fontFamily="monospace"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#ECE8E1"
            android:textSize="22sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="#ECE8E1"
            android:textSize="14sp" />

        <!-- 三個按鈕排滿一列：先照字的長度給寬度，多出來的平分。直拿時清除按鈕的字比較短（values-port/strings.xml） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clean"
                style="@style/Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/clean" />

            <Button
                android:id="@+id/dim"
                style="@style/Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/dim" />

            <Button
                android:id="@+id/scan"
                style="@style/Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
