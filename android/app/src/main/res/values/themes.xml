<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Recorder" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:buttonStyle">@style/Button</item>
    </style>

    <!-- 按鈕文字不要自動轉大寫（「QR Code」才不會變成「QR CODE」） -->
    <style name="Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 直拿時下排的按鈕：字小一點、左右留白少一點、不限最小寬度，360dp 寬的手機上三個也排得進一列 -->
    <style name="Button.Compact">
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">6dp</item>
    </style>
</resources>
