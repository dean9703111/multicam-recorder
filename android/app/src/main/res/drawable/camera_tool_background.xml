<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><solid android:color="@android:color/transparent" /><corners android:radius="16dp" /></shape>
            </item>
            <item android:state_activated="true">
                <shape><solid android:color="#28FF7768" /><corners android:radius="16dp" /></shape>
            </item>
            <item android:state_selected="true">
                <shape><solid android:color="#2459B9FF" /><corners android:radius="16dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@android:color/transparent" /><corners android:radius="16dp" /></shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="16dp" /></shape>
    </item>
</ripple>
