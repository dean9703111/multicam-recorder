{
  "name": "multicam-recorder",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/server.ts --open",
    "demo": "node server/server.ts --open --demo",
    "fake-phone": "node tools/fake-phone.ts",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check.ts",
    "smoke-test": "node tools/smoke-test.ts",
    "android:build": "cd android && JAVA_HOME=${JAVA_HOME:-$(brew --prefix openjdk@21)/libexec/openjdk.jdk/Contents/Home} ./gradlew :app:assembleDebug",
    "android:install": "sh tools/install-android.sh"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "htm": "^3.1.1",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "description": "Control multiple phones as synchronized 4K cameras from a web dashboard on your computer over Wi-Fi.",
  "license": "MIT"
}
